# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# WealthIQ Security OTP & Email Delivery Configuration
# -----------------------------------------------------------------------------
# OTP_SECRET: High-entropy secret key used for HMAC-SHA256 hashing of OTP codes,
# reset tokens, and Remote Banking PINs.
# REQUIRED in production (server refuses to start if missing in NODE_ENV=production).
OTP_SECRET="replace-with-a-64-char-cryptographically-random-secret-key"

# OTP_DELIVERY_MODE: Controls how OTP codes are delivered.
# - "smtp" (default): Sends via Nodemailer SMTP (or logs to dev console / test inbox if SMTP env vars are unset in dev).
# - "mailto": Local demo mode only (disabled in NODE_ENV=production) — opens user's default mail client with prefilled draft.
OTP_DELIVERY_MODE="smtp"

# SMTP Email Configuration (e.g. Gmail with 2-Step Verification + 16-char App Password, SendGrid, Brevo, or Mailtrap)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-char-app-password"
EMAIL_FROM="\"WealthIQ Security\" <security@wealthiq.co.za>"
